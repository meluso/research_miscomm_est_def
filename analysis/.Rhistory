# Import libraries
library(psych)
library(ggplot2)
library(gplots)
# Import data
results <- read.csv("~/2016-Present (Michigan)/Research/12 Estimation Definitions/04 Analysis/Results/2018-11-10_08-13-06_MCResultsSummary.csv", header=FALSE)
names(results)[1:7] <- c('index','method','fn','probability','cycles','performance','degree')
# Create vectors of variables
fns = c("sphere","ackley","rosen","stybtang")
methods = c("current","future","best")
# Organize Data ----------------------------------------------------------------
# Slice data by functions
sphere = results[results$fn == "sphere",c(1:2,4:7)]
ackley = results[results$fn == "ackley",c(1:2,4:7)]
rosen = results[results$fn == "rosenbrock",c(1:2,4:7)]
stybtang = results[results$fn == "styblinski-tang",c(1:2,4:7)]
# Copy over column names
names(sphere)[1:6] = names(results)[c(1:2,4:7)]
names(ackley)[1:6] = names(results)[c(1:2,4:7)]
names(rosen)[1:6] = names(results)[c(1:2,4:7)]
names(stybtang)[1:6] = names(results)[c(1:2,4:7)]
# Slice data by methods
sphere.current = cbind(sphere[sphere$method == "future_est" & sphere$probability == 0,c(1,3:6)],"current")
sphere.hist = cbind(sphere[sphere$method == "future_est" & sphere$probability == 1,c(1,3:6)],"historical")
sphere.best = cbind(sphere[sphere$method == "best_est" & sphere$probability == 1,c(1,3:6)],"best")
ackley.current = cbind(ackley[ackley$method == "future_est" & ackley$probability == 0,c(1,3:6)],"current")
ackley.hist = cbind(ackley[ackley$method == "future_est" & ackley$probability == 1,c(1,3:6)],"historical")
ackley.best = cbind(ackley[ackley$method == "best_est" & ackley$probability == 1,c(1,3:6)],"best")
rosen.current = cbind(rosen[rosen$method == "future_est" & rosen$probability == 0,c(1,3:6)],"current")
rosen.hist = cbind(rosen[rosen$method == "future_est" & rosen$probability == 1,c(1,3:6)],"historical")
rosen.best = cbind(rosen[rosen$method == "best_est" & rosen$probability == 1,c(1,3:6)],"best")
stybtang.current = cbind(stybtang[stybtang$method == "future_est" & stybtang$probability == 0,c(1,3:6)],"current")
stybtang.hist = cbind(stybtang[stybtang$method == "future_est" & stybtang$probability == 1,c(1,3:6)],"historical")
stybtang.best = cbind(stybtang[stybtang$method == "best_est" & stybtang$probability == 1,c(1,3:6)],"best")
# Rename the new methods column
names(sphere.current)[6] = "method"
names(sphere.hist)[6] = "method"
names(sphere.best)[6] = "method"
names(ackley.current)[6] = "method"
names(ackley.hist)[6] = "method"
names(ackley.best)[6] = "method"
names(rosen.current)[6] = "method"
names(rosen.hist)[6] = "method"
names(rosen.best)[6] = "method"
names(stybtang.current)[6] = "method"
names(stybtang.hist)[6] = "method"
names(stybtang.best)[6] = "method"
# Combine the data by method
sphere.methods = rbind(sphere.current,sphere.hist,sphere.best)
ackley.methods = rbind(ackley.current,ackley.hist,ackley.best)
rosen.methods = rbind(rosen.current,rosen.hist,rosen.best)
stybtang.methods = rbind(stybtang.current,stybtang.hist,stybtang.best)
